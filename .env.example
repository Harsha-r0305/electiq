# ---- PostgreSQL ----
# Owner connection: used ONLY by the setup/seed scripts (creates tables, roles, policies).
OWNER_DATABASE_URL=postgres://postgres:postgres@localhost:5432/electiq
# Application connection: the NOINHERIT login role created by db/03_security.sql.
# The password below is applied to app_login by `npm run db:setup`.
APP_LOGIN_PASSWORD=change_me_app_login_pw
DATABASE_URL=postgres://app_login:change_me_app_login_pw@localhost:5432/electiq

# ---- Neo4j (graph database) ----
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j_pw

# ---- Auth ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string_at_least_32_chars

# ---- AI semantic elective search (see docs/VECTOR_SEARCH.md) ----
EMBEDDING_SERVICE_URL=http://127.0.0.1:8001
# Optional shared secret between Next.js and the embedding service (set the same value in both)
EMBEDDING_SERVICE_TOKEN=
# Results below this cosine similarity are dropped so unrelated queries do not look like good matches
SEMANTIC_MIN_SIMILARITY=0.25
COOKIE_SECURE=false
